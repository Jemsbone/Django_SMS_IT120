# Django Core Settings
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration (pgAdmin)
DB_NAME=sms_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Textlink SMS Gateway Configuration (https://textlinksms.com/)
TEXTLINK_API_KEY=your_textlink_api_key_here
TEXTLINK_API_URL=https://textlinksms.com/api/send
TEXTLINK_SENDER_ID=IT120SMS

# Put your mobile number here so the web form auto-fills it for quick testing!
DEFAULT_RECIPIENT_PHONE=09123456789

